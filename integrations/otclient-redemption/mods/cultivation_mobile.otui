CultivationMobilePanel < Panel
  id: cultivationMobilePanel
  size: 360 166
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  margin-left: 8
  margin-bottom: 8
  focusable: false
  phantom: false
  background-color: #111a1eE8
  border-width: 1
  border-color: #927448

  Label
    id: mobileTitle
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 2
    text: CULTIVATION
    color: #e4c98a
    font: verdana-11px-rounded

  Button
    id: north
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 44
    margin-top: 22
    size: 42 34
    text: N
    @onClick: CultivationMobile.move(North)

  Button
    id: west
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 2
    margin-top: 58
    size: 42 34
    text: W
    @onClick: CultivationMobile.move(West)

  Button
    id: east
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 86
    margin-top: 58
    size: 42 34
    text: E
    @onClick: CultivationMobile.move(East)

  Button
    id: south
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 44
    margin-top: 94
    size: 42 34
    text: S
    @onClick: CultivationMobile.move(South)

  Button
    id: target
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 142
    margin-top: 22
    size: 66 38
    text: Target
    @onClick: CultivationMobile.attackNearestMonster()

  Button
    id: bolt
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 212
    margin-top: 22
    size: 66 38
    text: Bolt
    @onClick: CultivationMobile.say("!spiritbolt")

  Button
    id: meditate
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 282
    margin-top: 22
    size: 70 38
    text: Meditate
    @onClick: CultivationMobile.say("!cultivate")

  Button
    id: heal
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 142
    margin-top: 64
    size: 66 38
    text: Heal
    @onClick: CultivationMobile.say("!heal")

  Button
    id: breakthrough
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 212
    margin-top: 64
    size: 66 38
    text: Break
    @onClick: CultivationMobile.say("!breakthrough")

  Button
    id: status
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 282
    margin-top: 64
    size: 70 38
    text: Status
    @onClick: CultivationMobile.say("!realm")

  Button
    id: quest
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 142
    margin-top: 106
    size: 102 36
    text: Quest
    @onClick: CultivationMobile.say("!quest")

  Button
    id: help
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 248
    margin-top: 106
    size: 104 36
    text: Commands
    @onClick: CultivationMobile.say("!culthelp")
